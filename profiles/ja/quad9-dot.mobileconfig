			<string>C665BE95-CABC-5236-A8E7-5E076A3A4202</string>
			<key>PayloadDisplayName</key>
			<string>howToSafeDNS · Quad9 · DoT</string>
			<key>DNSSettings</key>
			<dict>
				<key>DNSProtocol</key>
				<string>TLS</string>
				<key>ServerAddresses</key>
				<array>
					<string>9.9.9.9</string>
					<string>149.112.112.112</string>
					<string>2620:fe::fe</string>
					<string>2620:fe::9</string>
				</array>
				<key>ServerName</key>
				<string>dns.quad9.net</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
