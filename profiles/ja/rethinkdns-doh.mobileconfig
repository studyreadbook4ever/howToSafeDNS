			<key>PayloadDisplayName</key>
			<string>howToSafeDNS · RethinkDNS · DoH</string>
			<key>DNSSettings</key>
			<dict>
				<key>DNSProtocol</key>
				<string>HTTPS</string>
				<key>ServerURL</key>
				<string>https://max.rethinkdns.com/</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
