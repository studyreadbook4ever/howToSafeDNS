				<array>
					<string>116.202.176.26</string>
					<string>2a01:4f8:1c0c:8274::1</string>
				</array>
				<key>ServerURL</key>
				<string>https://doh.libredns.gr/dns-query</string>
			</dict>
		</dict>
	</array>
</dict>
