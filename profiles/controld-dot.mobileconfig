			<key>PayloadDisplayName</key>
			<string>howToSafeDNS · Control D · DoT</string>
			<key>DNSSettings</key>
			<dict>
				<key>DNSProtocol</key>
				<string>TLS</string>
				<key>ServerAddresses</key>
				<array>
					<string>76.76.2.11</string>
					<string>76.76.10.11</string>
					<string>2606:1a40::11</string>
					<string>2606:1a40:1::11</string>
				</array>
				<key>ServerName</key>
				<string>p1.freedns.controld.com</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
